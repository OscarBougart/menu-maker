# Copy this file to ".env" and paste your real key below.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional overrides:
# MENU_MODEL=claude-sonnet-4-20250514
# PORT=8787

# Production (Vercel) — set these in the Vercel dashboard, NOT here:
#   ANTHROPIC_API_KEY   (required) your key
#   MENU_MODEL          (optional) model override
#   RATE_LIMIT_PER_HOUR (optional, default 20) max AI calls per IP per hour
